PORT=5000

# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5433/mini_online_store?schema=public"

# JWT Authentication
JWT_SECRET="YOUR_JWT_SECRET_KEY_HERE"
JWT_EXPIRES_IN="7d"

# Administrator Initial Setup (Used with 'npm run create-admin')
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD_HERE"
# ADMIN_NAME="Administrator"
